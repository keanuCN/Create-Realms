# ===== 基础配置 =====
APP_NAME=AIGC 工坊

# ===== 数据库（Docker 部署时由 compose 覆盖，本地开发指向 127.0.0.1）=====
DATABASE_URL=postgres://aigc:aigc@127.0.0.1:5432/aigc

# ===== 媒体文件存储目录 =====
# Docker 部署使用 /data/media（compose 已配置 volume）
# 本地开发用 ./data/media
MEDIA_DIR=./data/media

# ===== MiniMax 开放平台 =====
# 在 https://platform.minimax.cn/user-center/basic-information/interface-key 获取
MINIMAX_API_KEY=
# 国内站 https://api.minimax.cn ；国际站 https://api.minimax.io
MINIMAX_API_BASE=https://api.minimax.cn
# 没有 Key 时想先看界面可以设 1（生成的是占位素材）
MINIMAX_MOCK=0

# ===== 管理员账号（首次启动时自动创建）=====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=please-change-me

# ===== 其他 =====
SESSION_DAYS=30
WORKER_CONCURRENCY=2
